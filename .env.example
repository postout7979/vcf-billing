# ==========================================================================
# VCF Billing Portal - environment configuration example
# 복사해서 .env 로 저장한 뒤 값을 채우세요: cp .env.example .env
#
# [v4.0] 이 파일은 Docker Compose(docker-compose.yml)가 그대로 읽는 파일이다
# (`env_file: .env`). api/collector/db 컨테이너가 모두 이 하나의 .env를 공유한다.
# ==========================================================================

# VCF Operations 연동 자격증명은 여기(.env)가 아니라 관리자 화면의
# "계정 연동" 메뉴에서 독립적으로 등록합니다 (DB에 암호화되어 저장됨). 하나의 연동
# 계정 인벤토리를 여러 테넌트/프로젝트로 나눠 사용할 수 있습니다.

# 데이터 수집 주기(분). 과금 단위와 항상 일치합니다.
COLLECTOR_INTERVAL_MINUTES=5

# 프로젝트별 "사용량 가중치 반영" 과금(관리자 화면 요금 설정)을 위해 VM마다
# CPU/메모리 실사용률을 추가로 수집할지 여부. VM 수가 매우 많은 환경에서
# 수집 부하를 줄이려면 false로 끄세요(끄면 가중치 켠 프로젝트도 정액 요금으로
# 계산됩니다). 자세한 내용은 README.md의 "사용량 가중치 하이브리드 과금" 참고.
COLLECT_USAGE_METRICS=true

# 앱 보안
# SECRET_KEY는 JWT 서명뿐 아니라 연동 계정 비밀번호를 암호화하는 키로도 쓰입니다.
# 반드시 충분히 긴 랜덤 값으로 바꾸세요 (예: openssl rand -hex 32). 운영 중에는
# 절대 바꾸지 마세요 - 바꾸면 이미 저장된 연동 계정 비밀번호를 복호화할 수 없습니다.
SECRET_KEY=please-change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --------------------------------------------------------------------------
# PostgreSQL [v4.0] - docker-compose.yml의 db 서비스가 이 4개 값 중
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB를 그대로 읽어 최초 기동 시
# 데이터베이스/계정을 생성한다. DATABASE_URL은 그 값들과 반드시 일치해야 한다 -
# 아래 3개 중 하나라도 바꾸면 DATABASE_URL의 해당 부분도 같이 바꾸세요.
# (db 컨테이너를 이미 한 번 띄운 뒤에 POSTGRES_PASSWORD만 바꿔도 기존 볼륨 안의
#  실제 DB 비밀번호는 바뀌지 않으니 주의 - 바꾸려면 DB 안에서 직접 ALTER ROLE 필요)
# --------------------------------------------------------------------------
POSTGRES_USER=vcfbilling
POSTGRES_PASSWORD=please-change-this-too
POSTGRES_DB=vcfbilling

# db = docker-compose.yml 안의 PostgreSQL 서비스 이름 (컨테이너 간 통신은 서비스
# 이름을 호스트명으로 사용). docker-compose 없이 이 저장소를 그냥
# `uvicorn app.main:app`으로 로컬에서 빠르게 띄워보고 싶다면, 이 줄을 지우거나
# 주석 처리하세요 - app/config.py 기본값(SQLite 파일)으로 자동 폴백됩니다.
DATABASE_URL=postgresql+psycopg://vcfbilling:please-change-this-too@db:5432/vcfbilling

# --------------------------------------------------------------------------
# Container DNS resolution [v4.1] - only matters for the api/collector
# containers, which need to resolve your VCF Operations
# hostname to reach it.
#
# Ubuntu commonly runs systemd-resolved, whose /etc/resolv.conf points at
# the stub resolver 127.0.0.53 - a loopback address that only works on the
# host itself, not from inside a container's separate network namespace.
# If your VCF Operations hostname lives on an internal or
# corporate-only DNS zone, containers can fail to resolve it even though
# the host resolves it fine, surfacing as an integration sync error like
# "[Errno -3] Temporary failure in name resolution".
#
# Find the DNS server(s) your host actually uses upstream with:
#   resolvectl status | grep -A3 "Current DNS Server"
# (or check /etc/systemd/resolved.conf / your network config) and put that
# IP here so the containers resolve internal hostnames the same way the
# host does. The defaults below are public resolvers and will NOT resolve
# internal/corporate hostnames.
# --------------------------------------------------------------------------
DOCKER_DNS_1=1.1.1.1
DOCKER_DNS_2=8.8.8.8
