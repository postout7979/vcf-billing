# ==========================================================================
# VCF Billing Portal - environment configuration example
# 복사해서 .env 로 저장한 뒤 값을 채우세요: cp .env.example .env
# ==========================================================================

# VCF Operations/Aria Operations 연동 자격증명은 여기(.env)가 아니라 관리자 화면의
# "계정 연동" 메뉴에서 독립적으로 등록합니다 (DB에 암호화되어 저장됨). 하나의 연동
# 계정 인벤토리를 여러 테넌트/프로젝트로 나눠 사용할 수 있습니다.

# 데이터 수집 주기(분). 과금 단위와 항상 일치합니다.
COLLECTOR_INTERVAL_MINUTES=5

# 프로젝트별 "사용량 가중치 반영" 과금(관리자 화면 요금 설정)을 위해 VM마다
# CPU/메모리 실사용률을 추가로 수집할지 여부. VM 수가 매우 많은 환경에서
# 수집 부하를 줄이려면 false로 끄세요(끄면 가중치 켠 프로젝트도 정액 요금으로
# 계산됩니다). 자세한 내용은 README.md의 "사용량 가중치 하이브리드 과금" 참고.
COLLECT_USAGE_METRICS=true

# 앱 보안
# SECRET_KEY는 JWT 서명뿐 아니라 위 연동 계정 비밀번호를 암호화하는 키로도 쓰입니다.
# 반드시 충분히 긴 랜덤 값으로 바꾸세요 (예: openssl rand -hex 32).
SECRET_KEY=please-change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite 파일 경로 (다른 RDBMS로 교체 가능: DATABASE_URL 사용)
DATABASE_URL=sqlite:///./data/billing.db
